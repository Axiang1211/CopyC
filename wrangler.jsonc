// CopyC 官網：Cloudflare Workers 靜態資產（website/ 為純靜態檔案，不需建置）
{
  "name": "copyc",
  "compatibility_date": "2026-10-01",
  // 只有介紹影片會先經過 Worker，用來支援 Range 請求（Safari 播放 MP4 需要）
  "main": "./worker/index.js",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/assets/video/*"]
  }
}
