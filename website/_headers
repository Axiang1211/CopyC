/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src https://api.github.com https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'

/assets/*
  Cache-Control: public, max-age=604800

# App 的遠端資料：每次都向伺服器確認是否有新版本
/config/*
  Cache-Control: no-cache
