{
  "name": "copyc",
  "private": true,
  "version": "1.0.3",
  "description": "CopyC — 桌面複製即時回饋工具（Windows & macOS）",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "node scripts/build.mjs",
    "build:mac": "tauri build --target universal-apple-darwin --bundles dmg",
    "build:win": "tauri build --bundles nsis",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:app": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3"
  }
}
