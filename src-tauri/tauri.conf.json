{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CopyC",
  "version": "1.0.3",
  "identifier": "top.dreamsworld.copyc",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "deb"],
    "category": "Utility",
    "shortDescription": "複製即時回饋工具",
    "longDescription": "CopyC 在你每次成功複製時，於螢幕上方或游標旁彈出輕量提示，告別複製焦慮與重複按鍵。",
    "copyright": "© 2026 CopyC",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["TradChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 600, "height": 380 }
      }
    }
  }
}
